# Copy this file to `.env` and fill in your own values.
# Full explanation of every variable: docs/environment-variables.md

# Port the API server listens on
PORT=4000

# MongoDB connection string. NOTE: the variable is MONGO_URI, not MONGODB_URI
# (team convention — see CLAUDE.md).
#
# The db name must sit between the host and the `?`. The team's shared dev
# database is `ignition-dashboard-dev`; a separate one is used in production.
#
# mongodb+srv://<db_username>:<db_password>@ignition-hacks.0b0zeip.mongodb.net/ignition-dashboard-dev?appName=ignition-hacks
MONGO_URI=

# Secret used to sign JWTs. Use a long random string; never commit the real value.
# Generate one:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-me-with-a-long-random-string

# How long a login token stays valid.
JWT_EXPIRES_IN=7d
